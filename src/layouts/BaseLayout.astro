---
import '../styles/global.css';
import { groups } from '../lib/docs';

interface Props {
  title?: string;
  description?: string;
  activeSlug?: string;
}

const {
  title = 'Tuna Story',
  description = 'Tuna Sweeper 스토리와 등장인물 설정 문서',
  activeSlug = '',
} = Astro.props;
const pageTitle = title === 'Tuna Story' ? title : `${title} · Tuna Story`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f0e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Tuna Story 홈">
        <span class="brand-mark" aria-hidden="true">T</span>
        <span><strong>TUNA</strong><em>STORY ARCHIVE</em></span>
      </a>
      <div class="topbar-actions">
        <span class="status"><i></i> STORY SSOT</span>
        <a class="github-link" href="https://github.com/octopus7/tunastory" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </header>

    <div class="shell">
      <aside class="sidebar" aria-label="문서 탐색">
        <nav>
          <a class:list={["home-link", { active: activeSlug === 'home' }]} href="/">
            <span>⌂</span> 문서 홈
          </a>
          {groups.map((group) => (
            <section class="nav-group">
              <p>{group.label}</p>
              {group.docs.map((doc) => (
                <a class:list={{ active: activeSlug === doc.slug }} href={`/${doc.slug}/`}>
                  {doc.title}
                </a>
              ))}
            </section>
          ))}
        </nav>
        <div class="sidebar-note">
          <span>현재 기준</span>
          <strong>루나 + 두더지</strong>
          <p>데모와 정규 스토리를 분리해 관리합니다.</p>
        </div>
      </aside>

      <main class="main-content">
        <slot />
        <footer>
          <span>TUNA STORY ARCHIVE</span>
          <span>Built with Astro · Deployed on Cloudflare Pages</span>
        </footer>
      </main>
    </div>
  </body>
</html>
