---
import '../styles/global.css';
import { groups } from '../lib/docs';
import { BUILD_TIME } from '../lib/build';

interface Props {
  title?: string;
  description?: string;
  activeSlug?: string;
}

const {
  title = 'Tuna Story',
  description = 'Tuna Sweeper 스토리와 등장인물 설정 문서',
  activeSlug = '',
} = Astro.props;
const pageTitle = title === 'Tuna Story' ? title : `${title} · Tuna Story`;
// Rendered into the static HTML during each Cloudflare Pages build.
const deployedAt = BUILD_TIME;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f0e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Tuna Story 홈">
        <img class="brand-mark" src="/images/brand/tuna-can-mark.webp" alt="" width="128" height="128" aria-hidden="true" />
        <span><strong>TUNA</strong><em>STORY ARCHIVE</em></span>
      </a>
      <div class="topbar-actions">
        <span class="status"><i></i> STORY SSOT</span>
        <a class="github-link" href="https://github.com/octopus7/tunastory" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </header>

    <div class="shell">
      <aside class="sidebar" aria-label="문서 탐색">
        <nav>
          <a class:list={["home-link", { active: activeSlug === 'home' }]} href="/">
            <span>⌂</span> 문서 홈
          </a>
          <a class:list={["home-link", { active: activeSlug === 'gallery' }]} href="/gallery/">
            <span>◈</span> 갤러리
          </a>
          <a class:list={["home-link", { active: activeSlug === 'devtuna' }]} href="/devtuna/">
            <span>◉</span> devTuna 소개
          </a>
          {groups.map((group) => (
            <section class="nav-group">
              <p>{group.label}</p>
              {group.docs.map((doc) => (
                <a class:list={{ active: activeSlug === doc.slug }} href={`/${doc.slug}/`}>
                  {doc.title}
                </a>
              ))}
            </section>
          ))}
        </nav>
        <div class="sidebar-note">
          <span>현재 기준</span>
          <strong>루나 + 두더지</strong>
          <p>데모와 정규 스토리를 분리해 관리합니다.</p>
        </div>
      </aside>

      <main class="main-content">
        <slot />
        <footer class:list={["site-footer", { "site-footer--home": activeSlug === 'home' }]}>
          {activeSlug === 'home' && (
            <section class="site-keeper" aria-label="사이트 관리 정보">
              <img
                src="/images/mole-sleeping-128.webp"
                alt="눈을 감고 졸고 있는 두더지"
                width="128"
                height="128"
                loading="lazy"
              />
              <div>
                <span>SITE KEEPER · MOLE</span>
                <strong>이 페이지는 두더지가 관리하고 있습니다.</strong>
                <p>지금은 잠깐 졸고 있는 중입니다.</p>
              </div>
            </section>
          )}
          <div class="footer-meta">
            <span>TUNA STORY ARCHIVE</span>
            <div class="deploy-info">
              <span>LAST DEPLOY</span>
              <time datetime={deployedAt} data-deployed-at={deployedAt}>{deployedAt}</time>
            </div>
            <span>Built with Astro · Deployed on Cloudflare Pages</span>
          </div>
        </footer>
      </main>
    </div>
    <script is:inline>
      (() => {
        const time = document.querySelector('[data-deployed-at]');
        if (!(time instanceof HTMLTimeElement)) return;

        const deployed = new Date(time.dataset.deployedAt || time.dateTime);
        if (Number.isNaN(deployed.getTime())) return;

        const absolute = new Intl.DateTimeFormat(navigator.language || 'ko-KR', {
          dateStyle: 'medium',
          timeStyle: 'short',
        });

        const update = () => {
          const seconds = Math.floor(Math.max(0, Date.now() - deployed.getTime()) / 1000);
          const exact = absolute.format(deployed);

          if (seconds <= 3 * 60 * 60) {
            if (seconds < 60) time.textContent = `${seconds}초 전`;
            else if (seconds < 60 * 60) time.textContent = `${Math.floor(seconds / 60)}분 전`;
            else time.textContent = `${Math.floor(seconds / 3600)}시간 전`;
            time.title = exact;
          } else {
            time.textContent = exact;
            time.removeAttribute('title');
          }
        };

        update();
        window.setInterval(update, 1000);
      })();
    </script>
  </body>
</html>
