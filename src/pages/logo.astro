<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>Tuna Sweeper Logo</title>
    <style>
      * { box-sizing: border-box; }
      html, body { width: 100%; min-height: 100%; margin: 0; background: #000; }
      body { min-height: 100svh; display: grid; place-items: center; overflow: hidden; }
      main { width: 100%; min-height: 100svh; display: grid; place-items: center; padding: clamp(24px, 7vw, 96px); }
      img { display: block; width: min(860px, 86vw); max-height: 80svh; height: auto; object-fit: contain; }
    </style>
  </head>
  <body>
    <main aria-label="Tuna Sweeper 투명 로고 검정 배경 보기">
      <img
        src="/images/brand/tuna-sweeper-logo-transparent.png"
        alt="Tuna Sweeper · devTuna"
        width="483"
        height="334"
      />
    </main>
  </body>
</html>
