---
import BaseLayout from '../layouts/BaseLayout.astro';
import { docs, renderMarkdown, type StoryDoc } from '../lib/docs';

export function getStaticPaths() {
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

interface Props { doc: StoryDoc }
const { doc } = Astro.props;
let html = renderMarkdown(doc.body);

function characterGallery(character: 'luna' | 'mole', name: string, portraitAlt: string, fullAlt: string) {
  const portraitHeight = character === 'luna' ? 960 : 844;
  const fullHeight = character === 'luna' ? 1152 : 864;
  return `
    <section class="character-reference" aria-label="${name} 캐릭터 이미지">
      <div class="character-reference__heading">
        <div><span>VISUAL REFERENCE · CURRENT VERSION</span><strong>${name}</strong></div>
        <div class="character-reference__controls" aria-label="${name} 이미지 탐색">
          <button type="button" data-slide="prev" aria-label="이전 이미지">←</button>
          <button type="button" data-slide="next" aria-label="다음 이미지">→</button>
        </div>
      </div>
      <div class="character-reference__grid">
        <figure class="character-shot character-shot--portrait">
          <img src="/images/characters/${character}-portrait.webp" alt="${portraitAlt}" width="768" height="${portraitHeight}" loading="lazy" />
        </figure>
        <figure class="character-shot character-shot--full">
          <img src="/images/characters/${character}-full.webp" alt="${fullAlt}" width="768" height="${fullHeight}" loading="lazy" />
        </figure>
      </div>
    </section>`;
}

if (doc.slug === 'characters') {
  html = html
    .replace(
      '<h2>1. 루나 (Luna)</h2>',
      `<h2>1. 루나 (Luna)</h2>${characterGallery(
        'luna',
        '루나',
        '은회색 양갈래와 파란 눈, 검은 리본과 메이드 복장의 루나 상반신 초상화',
        '검정과 흰색 메이드 복장을 입은 루나의 머리부터 신발까지 전신 설정화',
      )}`,
    )
    .replace(
      '<h2>2. 두더지</h2>',
      `<h2>2. 두더지</h2>${characterGallery(
        'mole',
        '두더지',
        '시력이 좋지 않아 눈을 감고 있는 두더지 상반신 초상화',
        '눈을 감고 두 발로 서서 한 손을 들어 인사하는 두더지 전신 설정화',
      )}`,
    );
}
---

<BaseLayout title={doc.title} description={doc.description} activeSlug={doc.slug}>
  <article class="document-page">
    <header class="document-header">
      <span class="kicker">{doc.eyebrow}</span>
      <h1>{doc.title}</h1>
      <p>{doc.description}</p>
      <div class="document-meta">
        <span>MARKDOWN → HTML</span>
        <a href={`https://github.com/octopus7/tunastory/blob/main/${encodeURI(doc.source)}`} target="_blank" rel="noreferrer">원본 보기 ↗</a>
      </div>
    </header>
    {doc.slug === 'characters' && (
      <figure class="character-keyart">
        <img
          src="/images/luna-mole-character-intro.webp"
          alt="기지 관제실에서 지도를 보며 대화하는 루나와 눈을 감고 헤드셋을 쓴 두더지"
          width="1672"
          height="941"
          loading="eager"
        />
        <figcaption>
          <span>CHARACTER RELATIONSHIP · CURRENT VERSION</span>
          <strong>세상을 알아가는 루나와, 비밀을 품은 안내자 두더지</strong>
        </figcaption>
      </figure>
    )}
    <div class="document-body" set:html={html} />
    <nav class="document-end" aria-label="문서 종료">
      <span>END OF DOCUMENT</span>
      <a href="/">문서 홈으로 돌아가기 →</a>
    </nav>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.character-reference').forEach((section) => {
    const track = section.querySelector<HTMLElement>('.character-reference__grid');
    const cards = [...section.querySelectorAll<HTMLElement>('.character-shot')];
    const previous = section.querySelector<HTMLButtonElement>('[data-slide="prev"]');
    const next = section.querySelector<HTMLButtonElement>('[data-slide="next"]');
    if (!track || !previous || !next || cards.length === 0) return;

    const cardPosition = (card: HTMLElement) => card.offsetLeft - track.offsetLeft;
    const activeIndex = () => cards.reduce(
      (best, card, index) => Math.abs(cardPosition(card) - track.scrollLeft) < Math.abs(cardPosition(cards[best]) - track.scrollLeft) ? index : best,
      0,
    );
    const updateControls = () => {
      const active = activeIndex();
      previous.disabled = active === 0;
      next.disabled = active === cards.length - 1;
    };
    const move = (direction: number) => {
      const target = Math.max(0, Math.min(cards.length - 1, activeIndex() + direction));
      track.scrollTo({ left: cardPosition(cards[target]), behavior: 'smooth' });
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', updateControls, { passive: true });
    new ResizeObserver(updateControls).observe(track);
    updateControls();
  });
</script>
